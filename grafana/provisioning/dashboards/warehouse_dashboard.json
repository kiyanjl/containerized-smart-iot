        "target": {
          "limit": 100,
          "query": "from(bucket: \"warehouse_metrics\") |> range(start: v.timeRangeStart, stop: v.timeRangeStop) |> filter(fn: (r) => r._measurement == \"warehouse_event\" and r._field == \"value\") |> filter(fn: (r) => r.event == \"DEVICE_OFFLINE\" or r.event == \"DEVICE_ONLINE\") |> map(fn: (r) => ({time: r._time, title: r.event, text: r.warehouse_id + \" via \" + r.source, tags: r.event + \",\" + r.warehouse_id}))",
          "refId": "AnnoConnectivity",
          "textColumn": "text",
          "timeColumn": "time",
          "titleColumn": "title",
          "tagsColumn": "tags"
        },
        "type": "tags"
      },
